      "expectedJcs": "{\"𐀀\":\"astral\",\"\":\"bmp\"}"
    },
    {
      "name": "utf16-bmp-order",
      "input": { "Ω": 3, "é": 2, "z": 1 },
      "expectedJcs": "{\"z\":1,\"é\":2,\"Ω\":3}"
    },
    {
